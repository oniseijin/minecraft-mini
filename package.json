{
  "name": "minecraft-mini",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "lan": "npm run lan -w server",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p server && tsc --noEmit -p client"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
