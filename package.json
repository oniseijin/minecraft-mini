{
  "name": "minecraft-mini",
  "version": "0.4.0",
  "description": "A tiny browser-based voxel sandbox + Hive-style mini-games for 2 players on LAN",
  "license": "MIT",
  "author": "oniseijin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oniseijin/minecraft-mini.git"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run build -w client",
    "build:test": "npm run build:test -w client",
    "start": "npm run start -w server",
    "lan": "npm run lan -w server",
    "deploy": "node scripts/deploy.mjs",
    "deploy:status": "node scripts/deploy.mjs --status",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p server && tsc --noEmit -p client",
    "smoke:net": "node tools/smoke-net.mjs",
    "smoke:bedwars": "node tools/smoke-bedwars.mjs",
    "smoke:party": "node tools/smoke-party.mjs",
    "smoke:powerups": "node tools/smoke-powerups.mjs",
    "smoke:rematch": "node tools/smoke-rematch.mjs",
    "smoke:solo": "node tools/smoke-solo.mjs",
    "smoke:bot": "node tools/smoke-bot.mjs",
    "smoke:murder": "node tools/smoke-murder.mjs"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
